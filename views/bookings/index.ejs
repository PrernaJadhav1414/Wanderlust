<% layout("/layouts/boilerplate") %>

<div class="row">
    <div class="col-lg-10 col-md-12 mx-auto mt-3">
        <h3 class="mb-4"><i class="fa-solid fa-calendar-check text-danger me-2"></i>My Reservations</h3>

        <% if (!bookings || bookings.length === 0) { %>
            <div class="card p-5 text-center shadow-sm border-0 rounded-4 my-4">
                <div class="card-body">
                    <i class="fa-solid fa-suitcase-rolling text-muted fa-4x mb-3"></i>
                    <h4>No reservations found</h4>
                    <p class="text-muted">You haven't booked any stays yet. Explore beautiful places and plan your trip!</p>
                    <a href="/listings" class="btn btn-danger btn-lg mt-2">Explore Listings</a>
                </div>
            </div>
        <% } else { %>
            <div class="row row-cols-1 row-cols-md-2 g-4">
                <% for (let booking of bookings) { %>
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                            <div class="row g-0 h-100">
                                <% if (booking.listing) { %>
                                    <div class="col-4 position-relative">
                                        <img src="<%= booking.listing.image ? booking.listing.image.url : '' %>" 
                                             class="img-fluid h-100 w-100" 
                                             style="object-fit: cover; min-height: 180px;" 
                                             alt="Listing Image">
                                    </div>
                                <% } %>
                                <div class="<%= booking.listing ? 'col-8' : 'col-12' %>">
                                    <div class="card-body d-flex flex-column justify-content-between h-100">
                                        <div>
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <h5 class="card-title mb-0 text-truncate">
                                                    <%= booking.listing ? booking.listing.title : 'Listing Unavailable' %>
                                                </h5>
                                                <% if (booking.status === 'Confirmed') { %>
                                                    <span class="badge bg-success">Confirmed</span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary">Cancelled</span>
                                                <% } %>
                                            </div>

                                            <% if (booking.listing) { %>
                                                <p class="card-text text-muted small mb-2">
                                                    <i class="fa-solid fa-location-dot me-1"></i><%= booking.listing.location %>, <%= booking.listing.country %>
                                                </p>
                                            <% } %>

                                            <div class="bg-light p-2 rounded-2 mb-2">
                                                <div class="row text-center g-1">
                                                    <div class="col-6 border-end">
                                                        <span class="text-muted d-block small">Check-in</span>
                                                        <strong><%= new Date(booking.checkIn).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></strong>
                                                    </div>
                                                    <div class="col-6">
                                                        <span class="text-muted d-block small">Check-out</span>
                                                        <strong><%= new Date(booking.checkOut).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></strong>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center small text-muted">
                                                <span><i class="fa-solid fa-users me-1"></i><%= booking.guests %> Guest(s)</span>
                                                <span class="fw-bold text-dark fs-6">&#8377; <%= booking.totalPrice.toLocaleString('en-IN') %></span>
                                            </div>
                                        </div>

                                        <div class="d-flex gap-2 mt-3 pt-2 border-top">
                                            <% if (booking.listing) { %>
                                                <a href="/listings/<%= booking.listing._id %>" class="btn btn-sm btn-outline-dark flex-grow-1">View Listing</a>
                                            <% } %>
                                            <% if (booking.status === 'Confirmed') { %>
                                                <form action="/bookings/<%= booking._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to cancel this reservation?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>
</div>
