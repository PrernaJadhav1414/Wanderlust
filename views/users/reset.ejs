<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-lg-6 col-md-8 col-sm-10 mx-auto">
        <h2 class="text-center mb-4"><i class="fa-solid fa-lock text-danger me-2"></i>Reset Password</h2>
        <div class="card shadow-sm border-0 rounded-4 p-4">
            <p class="text-muted text-center mb-4">Please enter your new password below.</p>
            <form action="/reset-password/<%= token %>" method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="password" class="form-label fw-semibold">New Password</label>
                    <input type="password" class="form-control" id="password" name="password" minlength="6" required>
                    <div class="invalid-feedback">Password must be at least 6 characters.</div>
                </div>
                <div class="mb-3">
                    <label for="confirmPassword" class="form-label fw-semibold">Confirm New Password</label>
                    <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" minlength="6" required>
                    <div class="invalid-feedback">Please confirm your password.</div>
                </div>
                <button type="submit" class="btn btn-danger btn-lg w-100 fw-bold shadow-sm">Update Password</button>
            </form>
        </div>
    </div>
</div>
