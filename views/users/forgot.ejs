<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-lg-6 col-md-8 col-sm-10 mx-auto">
        <h2 class="text-center mb-4"><i class="fa-solid fa-key text-danger me-2"></i>Forgot Password</h2>
        <div class="card shadow-sm border-0 rounded-4 p-4">
            <p class="text-muted text-center mb-4">Enter the email address associated with your WanderLust account and we will send you a password reset link.</p>
            <form action="/forgot-password" method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="email" class="form-label fw-semibold">Email Address</label>
                    <input type="email" class="form-control" id="email" name="email" placeholder="name@example.com" required>
                    <div class="invalid-feedback">Please enter a valid email address.</div>
                </div>
                <button type="submit" class="btn btn-danger btn-lg w-100 fw-bold shadow-sm">Send Reset Link</button>
            </form>
            <div class="text-center mt-3">
                <a href="/login" class="text-muted text-decoration-none small"><i class="fa-solid fa-arrow-left me-1"></i>Back to Login</a>
            </div>
        </div>
    </div>
</div>
