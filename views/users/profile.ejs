<% layout("/layouts/boilerplate") %>

<div class="container mt-4">
    <div class="row g-4">
        <!-- Left Sidebar: Profile Summary & Edit Card -->
        <div class="col-lg-4 col-md-5">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden sticky-top" style="top: 90px;">
                <div class="card-header bg-danger text-white text-center py-4 border-0">
                    <i class="fa-solid fa-circle-user fa-5x mb-2"></i>
                    <h4 class="fw-bold mb-0"><%= user.username %></h4>
                    <span class="badge bg-light text-danger mt-1">WanderLust Member</span>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label class="text-muted small d-block">Email Address</label>
                        <strong><i class="fa-solid fa-envelope me-2 text-danger"></i><%= user.email %></strong>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small d-block">Phone Number</label>
                        <strong><i class="fa-solid fa-phone me-2 text-danger"></i><%= user.phone || 'Not provided' %></strong>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small d-block">About / Bio</label>
                        <p class="text-secondary small mb-0"><%= user.bio %></p>
                    </div>

                    <button class="btn btn-outline-danger w-100 fw-bold mt-3" type="button" data-bs-toggle="collapse" data-bs-target="#editProfileForm" aria-expanded="false">
                        <i class="fa-solid fa-user-pen me-2"></i>Edit Profile
                    </button>

                    <!-- Collapsible Edit Profile Form -->
                    <div class="collapse mt-3" id="editProfileForm">
                        <div class="p-3 bg-light rounded-3 border">
                            <h6 class="fw-bold mb-3">Update Profile Info</h6>
                            <form action="/profile/edit" method="POST" class="needs-validation" novalidate>
                                <div class="mb-2">
                                    <label for="username" class="form-label small fw-semibold">Username</label>
                                    <input type="text" class="form-control form-control-sm" id="username" name="user[username]" value="<%= user.username %>" required>
                                </div>
                                <div class="mb-2">
                                    <label for="email" class="form-label small fw-semibold">Email</label>
                                    <input type="email" class="form-control form-control-sm" id="email" name="user[email]" value="<%= user.email %>" required>
                                </div>
                                <div class="mb-2">
                                    <label for="phone" class="form-label small fw-semibold">Phone</label>
                                    <input type="text" class="form-control form-control-sm" id="phone" name="user[phone]" value="<%= user.phone || '' %>" placeholder="+91 9876543210">
                                </div>
                                <div class="mb-3">
                                    <label for="bio" class="form-label small fw-semibold">Bio</label>
                                    <textarea class="form-control form-control-sm" id="bio" name="user[bio]" rows="3"><%= user.bio %></textarea>
                                </div>
                                <button type="submit" class="btn btn-danger btn-sm w-100 fw-bold">Save Changes</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Main Column: Listings & Bookings Dashboard -->
        <div class="col-lg-8 col-md-7">
            <!-- Nav Tabs -->
            <ul class="nav nav-pills mb-4 gap-2 border-bottom pb-3" id="profileTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-bold rounded-pill px-4" id="listings-tab" data-bs-toggle="tab" data-bs-target="#listings-pane" type="button" role="tab">
                        <i class="fa-solid fa-house-chimney me-2"></i>My Listings (<%= listings.length %>)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-bold rounded-pill px-4" id="bookings-tab" data-bs-toggle="tab" data-bs-target="#bookings-pane" type="button" role="tab">
                        <i class="fa-solid fa-calendar-check me-2"></i>My Reservations (<%= bookings.length %>)
                    </button>
                </li>
            </ul>

            <!-- Tab Content -->
            <div class="tab-content" id="profileTabsContent">
                <!-- Tab 1: My Listings -->
                <div class="tab-pane fade show active" id="listings-pane" role="tabpanel">
                    <% if (!listings || listings.length === 0) { %>
                        <div class="card p-5 text-center shadow-sm border-0 rounded-4">
                            <div class="card-body">
                                <i class="fa-solid fa-house-circle-xmark text-muted fa-3x mb-3"></i>
                                <h5>No properties listed yet</h5>
                                <p class="text-muted small">Share your house or apartment on WanderLust and start earning!</p>
                                <a href="/listings/new" class="btn btn-danger mt-2 fw-bold"><i class="fa-solid fa-plus me-1"></i>Add Your Place</a>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="row row-cols-1 row-cols-md-2 g-3">
                            <% for (let listing of listings) { %>
                                <div class="col">
                                    <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                                        <img src="<%= listing.image ? listing.image.url : '' %>" class="card-img-top" style="height: 160px; object-fit: cover;" alt="Listing Image">
                                        <div class="card-body d-flex flex-column justify-content-between p-3">
                                            <div>
                                                <h6 class="card-title fw-bold text-truncate mb-1"><%= listing.title %></h6>
                                                <p class="text-muted small mb-2"><i class="fa-solid fa-location-dot me-1"></i><%= listing.location %>, <%= listing.country %></p>
                                                <p class="fw-bold text-danger mb-0">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %> <span class="text-muted fw-normal small">/ night</span></p>
                                            </div>
                                            <div class="d-flex gap-2 mt-3 pt-2 border-top">
                                                <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-outline-dark flex-grow-1">View</a>
                                                <a href="/listings/<%= listing._id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>
                                                <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this listing?');">
                                                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    <% } %>
                </div>

                <!-- Tab 2: My Reservations -->
                <div class="tab-pane fade" id="bookings-pane" role="tabpanel">
                    <% if (!bookings || bookings.length === 0) { %>
                        <div class="card p-5 text-center shadow-sm border-0 rounded-4">
                            <div class="card-body">
                                <i class="fa-solid fa-suitcase-rolling text-muted fa-3x mb-3"></i>
                                <h5>No active reservations</h5>
                                <p class="text-muted small">You haven't booked any stays yet. Explore top destinations across the world!</p>
                                <a href="/listings" class="btn btn-danger mt-2 fw-bold">Explore Listings</a>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="d-flex flex-column gap-3">
                            <% for (let booking of bookings) { %>
                                <div class="card shadow-sm border-0 rounded-3 p-3">
                                    <div class="row align-items-center g-3">
                                        <% if (booking.listing) { %>
                                            <div class="col-3 col-md-2">
                                                <img src="<%= booking.listing.image ? booking.listing.image.url : '' %>" class="img-fluid rounded-3" style="height: 70px; width: 100%; object-fit: cover;" alt="Listing Image">
                                            </div>
                                        <% } %>
                                        <div class="<%= booking.listing ? 'col-9 col-md-10' : 'col-12' %>">
                                            <div class="d-flex justify-content-between align-items-start mb-1">
                                                <h6 class="fw-bold mb-0">
                                                    <%= booking.listing ? booking.listing.title : 'Listing Unavailable' %>
                                                </h6>
                                                <% if (booking.status === 'Confirmed') { %>
                                                    <span class="badge bg-success">Confirmed</span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary">Cancelled</span>
                                                <% } %>
                                            </div>
                                            <div class="text-muted small mb-2">
                                                <i class="fa-solid fa-calendar-days me-1"></i>
                                                <%= new Date(booking.checkIn).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %> - 
                                                <%= new Date(booking.checkOut).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                                &bull; <%= booking.guests %> Guest(s)
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <strong class="text-dark">&#8377; <%= booking.totalPrice.toLocaleString('en-IN') %></strong>
                                                <div class="d-flex gap-2">
                                                    <% if (booking.listing) { %>
                                                        <a href="/listings/<%= booking.listing._id %>" class="btn btn-sm btn-light border">View Listing</a>
                                                    <% } %>
                                                    <% if (booking.status === 'Confirmed') { %>
                                                        <form action="/bookings/<%= booking._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Cancel this reservation?');">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                                        </form>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>
